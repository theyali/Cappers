# Production: DEBUG=False and a long random SECRET_KEY; the app refuses to start without it.
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Baku
SITE_BASE_URL=http://localhost:8000

POSTGRES_DB=cappers
POSTGRES_USER=cappers
POSTGRES_PASSWORD=cappers_dev_password
DB_HOST=pgbouncer
DB_PORT=6432

REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2

NEUROKEFF_API_BASE_URL=https://sports.api-neurokeff.ru/api/v2
NEUROKEFF_API_TOKEN=
NEUROKEFF_LANG=ru,en
NEUROKEFF_PAGE_SIZE=100
NEUROKEFF_API_TIMEOUT=20
NEUROKEFF_GAME_INFO_ENDPOINT=/api/v1/games/info
NEUROKEFF_GAME_INFO_BATCH_SIZE=20
NEUROKEFF_GAME_PREDICTIONS_ENDPOINT=games/predictions
NEUROKEFF_GAME_PREDICTIONS_STALE_SECONDS=3600
NEUROKEFF_STUCK_LIVE_AFTER_MINUTES=10
NEUROKEFF_STUCK_LIVE_LIMIT=500
NEUROKEFF_MATCH_SYNC_LOCK_SECONDS=600
NEUROKEFF_PREMATCH_DAYS_AHEAD=1
NEUROKEFF_FINISHED_DAYS_BACK=2
COUPON_MATCH_STALE_SECONDS=60
COUPON_MATCH_STATE_CACHE_SECONDS=10
LOCAL_LOGO_DOWNLOAD_ENABLED=True
LOCAL_LOGO_TIMEOUT=8
LOCAL_LOGO_MAX_BYTES=2097152
LOCAL_LOGO_WEBP_QUALITY=82

# Local development prints password-reset and notification emails to the console.
# For production switch to django.core.mail.backends.smtp.EmailBackend.
# Beget SMTP production example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.beget.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=noreply@capper-hub.com
# EMAIL_HOST_PASSWORD=your_mailbox_password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@capper-hub.com
SERVER_EMAIL=noreply@capper-hub.com
SUPPORT_EMAIL=support@capper-hub.com
ADMINISTRATOR_EMAIL=administrator@capper-hub.com

# Telegram web login. Never commit the real bot token.
# Bot ID is derived automatically from the token; no bot username setting is required.
# In BotFather link your site domain to this bot before testing Telegram login.
TG_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=900

# Yandex SmartCaptcha on registration (console.yandex.cloud → SmartCaptcha). Empty keys disable it.
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Payment providers to enable, comma-separated: cloudpayments,nowpayments. Empty = payments off.
PAYMENTS_ENABLED_PROVIDERS=
# Кто принимает платежи: ip (ИП), ooo (ООО), self_employed (самозанятый).
PAYMENTS_MERCHANT_TYPE=ip
# Принимать тестовые платежи (тестовый терминал CloudPayments). В production — False.
PAYMENTS_ALLOW_TEST_PAYMENTS=False

# CloudPayments (личный кабинет → Сайты → Настройки). Значения ниже — заглушки:
# пока в них есть «change-me», провайдер считается не настроенным и платежи не принимает.
CLOUDPAYMENTS_PUBLIC_ID=pk_change-me-cloudpayments-public-id
CLOUDPAYMENTS_API_SECRET=change-me-cloudpayments-api-secret
CLOUDPAYMENTS_API_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_API_TIMEOUT=15
# Сколько минут ссылка на оплату действует.
CLOUDPAYMENTS_ORDER_TTL_MINUTES=60
# Чеки 54-ФЗ через онлайн-кассу CloudKassir. ИП и ООО — True; самозанятый — False
# (чек выдаётся в «Мой налог»). Если строку убрать, значение берётся по PAYMENTS_MERCHANT_TYPE.
CLOUDPAYMENTS_RECEIPTS_ENABLED=True
# Система налогообложения в чеке: 0 — ОСН, 1 — УСН «доходы», 2 — УСН «доходы минус расходы»,
# 4 — ЕСХН, 5 — патент.
CLOUDPAYMENTS_TAXATION_SYSTEM=1
# Код ставки НДС в чеке по документации CloudPayments (например 0, 10, 20). Пусто — без НДС.
CLOUDPAYMENTS_VAT=
# Способ расчёта (тег 1214): 4 — полный расчёт.
CLOUDPAYMENTS_RECEIPT_METHOD=4
# Предмет расчёта (тег 1212): 4 — услуга.
CLOUDPAYMENTS_RECEIPT_OBJECT=4

UVICORN_WORKERS=2
# Secret admin path instead of the default admin/.
ADMIN_URL=staff-4f9c2a/